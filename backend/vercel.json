{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npx prisma generate && npx nest build && node scripts/bake-db.js",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
